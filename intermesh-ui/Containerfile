FROM registry.access.redhat.com/ubi9/nginx-124:latest

LABEL maintainer="Giovanni Luca Izzi <gizzi@redhat.com>"
LABEL application="intermesh-ui"
LABEL tier="frontend"

USER root

# Remove fallback configuration blueprints to prevent security footprint exposure
RUN rm -rf /etc/nginx/nginx.conf /usr/share/nginx/html/*

COPY nginx.conf /etc/nginx/nginx.conf

COPY src/ /usr/share/nginx/html/

RUN chmod +x /usr/share/nginx/html/00-substitute-env.sh

RUN chown -R 1001:0 /usr/share/nginx/html /var/log/nginx /var/lib/nginx /etc/nginx && \
    chmod -R g+rwX /usr/share/nginx/html /var/log/nginx /var/lib/nginx /etc/nginx

EXPOSE 8080

USER 1001

CMD ["/bin/sh", "-c", "/usr/share/nginx/html/00-substitute-env.sh && nginx"]